Static Analyzer:

meson setup build --prefix=/usr --sbindir=/usr/bin \
    -Dextfs=enabled -Dfat=enabled -Dhfsp=enabled -Dbtrfs=enabled \
    -Dncursesw=enabled -Dntfs=enabled -Dexfat=enabled -Df2fs=enabled \
    -Dminix=enabled -Dxfs=enabled

ninja -C build -t clean
scan-build -k -v -V ninja -C build -j4


Sanitizer:

export CC=clang
export CFLAGS="$CFLAGS -Wall -fsanitize=address -fsanitize=undefined -fno-omit-frame-pointer -g"
export LDFLAGS="$LDFLAGS -fsanitize=address -fsanitize=undefined"

meson setup build --prefix=/usr --sbindir=/usr/bin \
    -Dextfs=enabled -Dfat=enabled -Dhfsp=enabled -Dbtrfs=enabled \
    -Dncursesw=enabled -Dntfs=enabled -Dexfat=enabled -Df2fs=enabled \
    -Dminix=enabled -Dxfs=enabled

ninja -C build -t clean
ninja -C build -j4
