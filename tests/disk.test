#!/bin/bash
set -e

. "$(dirname "$0")"/_common

# Whole-disk format 0003 test.
#
# Phase 1: the container and raw-only volumes.  A disk without a partition
# table is stored as a single raw volume; the raw-full and the sparse
# (zero-detecting) variants are round-tripped and compared byte for byte.
#
# Phase 2: MBR and GPT parsing, the partition table blob and manifest, one raw
# volume per partition plus gap volumes, and table restore (verbatim, or
# regenerated through libfdisk for a larger target).

ptlfs="../src/partclone.disk"
bs=4096
count=$((4*1024))   # 16 MiB

echo -e "partclone.disk (format 0003) test"
echo -e "================================\n"
_ptlbreak

# A mostly-zero disk with a few random regions, so that the sparse variant has
# something to skip and something to keep.
echo -e "create source disk $raw ($((bs*count)) bytes)\n"
[ -f $raw ] && rm $raw
dd if=/dev/zero of=$raw bs=$bs count=$count status=none
dd if=/dev/urandom of=$raw bs=$bs count=8  seek=1    conv=notrunc status=none
dd if=/dev/urandom of=$raw bs=$bs count=64 seek=1000 conv=notrunc status=none
smd5=$(md5sum $raw | awk '{print $1}')

for mode in full sparse; do
    if [ "$mode" = sparse ]; then
        opt="--sparse"
    else
        opt=""
    fi

    echo -e "\n[$mode] clone $raw to $img\n"
    [ -f $img ] && rm $img
    $ptlfs -c $opt -s $raw -O $img -L $logfile -F
    _check_return_code

    echo -e "[$mode] check $img\n"
    $ptlfs --check-image -s $img -L $logfile
    _check_return_code

    echo -e "[$mode] restore $img to $raw_restore\n"
    [ -f $raw_restore ] && rm $raw_restore
    dd if=/dev/zero of=$raw_restore bs=$bs count=$count status=none
    $ptlfs -r -s $img -O $raw_restore -L $logfile -F
    _check_return_code

    nmd5=$(md5sum $raw_restore | awk '{print $1}')
    if [ "X$smd5" != "X$nmd5" ]; then
        echo -e "\ndisk $mode test fail (md5 $smd5 != $nmd5)\n"
        exit 1
    fi
done

# ---------------------------------------------------------------------------
# Phase 2: partition tables
# ---------------------------------------------------------------------------

_disk_roundtrip() {
    # $1: source disk, $2: gap policy (may be empty), $3: label
    local src=$1 gaps=$2 label=$3
    local img="$$_$label.ptc" out="$$_$label.out" opt=""

    [ -n "$gaps" ] && opt="--gaps=$gaps"

    echo -e "\n[$label] clone\n"
    rm -f $img $out
    $ptlfs -c $opt -s $src -O $img -L $logfile -F
    _check_return_code

    echo -e "[$label] check\n"
    $ptlfs --check-image -s $img -L $logfile
    _check_return_code

    echo -e "[$label] restore\n"
    dd if=/dev/zero of=$out bs=512 count=$((sectors)) status=none
    $ptlfs -r -s $img -O $out -L $logfile -F
    _check_return_code

    if ! cmp -s $src $out; then
        echo -e "\n$label round-trip differs\n"
        exit 1
    fi

    rm -f $img $out
}

if command -v sfdisk >/dev/null 2>&1; then
    sectors=$((32*1024))          # 16 MiB disk
    gpt="$$_gpt.raw"
    mbr="$$_mbr.raw"

    # --- GPT: two partitions, one bootable-ish gap after the primary GPT ---
    echo -e "\ncreate GPT source disk $gpt\n"
    rm -f $gpt
    truncate -s $((sectors*512)) $gpt
    sfdisk $gpt >/dev/null 2>&1 <<'EOF'
label: gpt
start=2048, size=4096, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="p1"
start=8192, size=4096, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="p2"
EOF
    dd if=/dev/urandom of=$gpt bs=512 seek=2048 count=4096 conv=notrunc status=none
    dd if=/dev/urandom of=$gpt bs=512 seek=8192 count=4096 conv=notrunc status=none

    _disk_roundtrip $gpt ""       gpt
    _disk_roundtrip $gpt none     gpt-none
    _disk_roundtrip $gpt full     gpt-full
    _disk_roundtrip $gpt sparse   gpt-sparse

    # --- GPT regeneration onto a larger target ---
    echo -e "\n[gpt-grow] clone and restore onto a larger target\n"
    gimg="$$_gpt.ptc"
    big="$$_gpt-big.out"
    rm -f $gimg $big
    $ptlfs -c -s $gpt -O $gimg -L $logfile -F
    _check_return_code
    truncate -s $(((sectors+16*1024)*512)) $big
    $ptlfs -r -s $gimg -O $big -L $logfile -F
    _check_return_code

    # Partition data must be preserved at the same offsets ...
    if ! cmp -s <(dd if=$gpt bs=512 skip=2048 count=4096 status=none) \
                <(dd if=$big bs=512 skip=2048 count=4096 status=none); then
        echo -e "\ngpt-grow: partition 1 data differs\n"
        exit 1
    fi
    # ... and the backup GPT must be at the end of the (larger) target.
    if [ "$(dd if=$big bs=512 skip=$(((sectors+16*1024)-1)) count=1 status=none | head -c 8)" != "EFI PART" ]; then
        echo -e "\ngpt-grow: no backup GPT at the end of the larger target\n"
        exit 1
    fi
    rm -f $gimg $big

    # --- MBR with an extended partition and logical partitions ---
    echo -e "\ncreate MBR source disk $mbr\n"
    rm -f $mbr
    truncate -s $((sectors*512)) $mbr
    sfdisk $mbr >/dev/null 2>&1 <<'EOF'
label: dos
unit: sectors
start=2048, size=4096, type=83, bootable
start=8192, size=8192, type=5
start=10240, size=2048, type=83
start=14336, size=2048, type=83
EOF
    for s in 2048 10240 14336; do
        dd if=/dev/urandom of=$mbr bs=512 seek=$s count=2048 conv=notrunc status=none
    done

    _disk_roundtrip $mbr ""     mbr
    _disk_roundtrip $mbr full   mbr-full

    # --- corrupted disk header must be rejected without --force ---
    echo -e "\n[corrupt] a damaged disk header must be rejected\n"
    cimg="$$_gpt.ptc"
    bad="$$_bad.ptc"
    rm -f $cimg $bad
    $ptlfs -c -s $gpt -O $cimg -L $logfile -F
    _check_return_code
    cp $cimg $bad
    printf '\xff' | dd of=$bad bs=1 seek=500 conv=notrunc status=none
    if $ptlfs --check-image -s $bad -L $logfile >/dev/null 2>&1; then
        echo -e "\ncorrupted disk header was not detected\n"
        exit 1
    fi
    rm -f $cimg $bad $gpt $mbr

    # -----------------------------------------------------------------------
    # Phase 3: filesystem volumes (kernel partition devices)
    # -----------------------------------------------------------------------
    #
    # A partition holding a recognised filesystem is stored as a filesystem
    # volume (only its used blocks) and restored into place.  This needs a real
    # block device with kernel partition nodes, so it is skipped when loop
    # devices are not usable.

    _loop_priv() {
        if [ "$(id -u)" -eq 0 ]; then
            SUDO=""
            return 0
        fi
        if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
            SUDO="sudo"
            return 0
        fi
        return 1
    }

    _find_part() {
        # $1: loop device, $2: partition number
        local d=$1 n=$2 c
        for c in "${d}p${n}" "${d}${n}"; do
            if [ -b "$c" ]; then
                echo "$c"
                return 0
            fi
        done
        return 1
    }

    _loop_unlock() {
        # Allow this user to open the loop device and its partitions.
        [ -n "$SUDO" ] && $SUDO chmod 666 "$fs_dev" "$fs_p1" "$fs_p2" 2>/dev/null
    }

    _loop_readable() {
        # Ready once the loop device and p1 can be read by this user; udev
        # settles the node permissions asynchronously, hence the retries.
        local i
        for i in $(seq 1 25); do
            _loop_unlock
            if [ -r "$fs_dev" ] && [ -r "$fs_p1" ]; then
                return 0
            fi
            sleep 0.2
        done
        return 1
    }

    if command -v losetup >/dev/null 2>&1 && command -v mkfs.ext4 >/dev/null 2>&1 && _loop_priv; then
        echo -e "\nphase 3: filesystem volumes through kernel partition devices\n"

        fs_disk="$$_fsdisk.raw"
        fs_img="$$_fs.ptc"
        fs_rawimg="$$_fsraw.ptc"
        fs_out="$$_fs.out"
        fs_big="$$_fsbig.out"
        fs_dev=""
        fs_p1=""

        _fs_cleanup() {
            [ -n "$fs_dev" ] && $SUDO losetup -d "$fs_dev" 2>/dev/null
            rm -f "$fs_disk" "$fs_img" "$fs_rawimg" "$fs_out" "$fs_big"
        }
        trap _fs_cleanup EXIT

        rm -f "$fs_disk"
        truncate -s $((128*1024*512)) "$fs_disk"
        sfdisk "$fs_disk" >/dev/null 2>&1 <<'EOF'
label: gpt
start=2048, size=40960, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="p1"
start=43008, size=20480, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="p2"
EOF

        fs_dev=$($SUDO losetup -f --show -P "$fs_disk" 2>/dev/null || true)

        # Wait for the kernel/udev to expose the partition devices.  The nodes
        # are created with restrictive permissions and udev keeps adjusting them
        # for a moment, so also make them readable by this user and retry until
        # that sticks.
        fs_p1=""
        fs_p2=""
        if [ -n "$fs_dev" ]; then
            for _ in $(seq 1 25); do
                fs_p1=$(_find_part "$fs_dev" 1 || true)
                [ -n "$fs_p1" ] && break
                sleep 0.2
            done
            fs_p2=$(_find_part "$fs_dev" 2 || true)
        fi

        if [ -z "$fs_dev" ] || [ -z "$fs_p1" ] || ! _loop_readable; then
            echo -e "loop devices not usable; skipping phase 3\n"
        else
            # p1 gets an ext4 filesystem, p2 stays raw (no filesystem).
            $SUDO mkfs.ext4 -q -F "$fs_p1"
            # mkfs triggers a partition "change" uevent; wait for the nodes to
            # be readable again before the tools open them.
            _loop_readable || true

            echo -e "[fsvol] clone (filesystem volumes)\n"
            rm -f "$fs_img"
            $ptlfs -c -s "$fs_dev" -O "$fs_img" -L $logfile -F
            _check_return_code

            echo -e "[fsvol] clone --no-fs-volumes (raw)\n"
            rm -f "$fs_rawimg"
            $ptlfs -c --no-fs-volumes -s "$fs_dev" -O "$fs_rawimg" -L $logfile -F
            _check_return_code

            # The filesystem volume stores only used blocks, so its image must
            # be smaller than the all-raw one.
            fssize=$(stat -c %s "$fs_img")
            rawsize=$(stat -c %s "$fs_rawimg")
            if [ "$fssize" -ge "$rawsize" ]; then
                echo -e "\n[fsvol] filesystem image not smaller than the raw one ($fssize >= $rawsize)\n"
                exit 1
            fi

            echo -e "[fsvol] check\n"
            $ptlfs --check-image -s "$fs_img" -L $logfile
            _check_return_code

            echo -e "[fsvol] restore to a same-size target\n"
            dd if=/dev/zero of="$fs_out" bs=512 count=$((128*1024)) status=none
            $ptlfs -r -s "$fs_img" -O "$fs_out" -L $logfile -F
            _check_return_code
            if ! cmp -s "$fs_dev" "$fs_out"; then
                echo -e "\n[fsvol] whole-disk round-trip differs\n"
                exit 1
            fi

            echo -e "[fsvol] restore to a larger target\n"
            truncate -s $((144*1024*512)) "$fs_big"
            $ptlfs -r -s "$fs_img" -O "$fs_big" -L $logfile -F
            _check_return_code
            if [ "$(dd if=$fs_big bs=512 skip=$((144*1024-1)) count=1 status=none | head -c 8)" != "EFI PART" ]; then
                echo -e "\n[fsvol] no backup GPT at the end of the larger target\n"
                exit 1
            fi
            if ! cmp -s <(dd if=$fs_dev bs=512 skip=2048 count=40960 status=none) \
                        <(dd if=$fs_big bs=512 skip=2048 count=40960 status=none); then
                echo -e "\n[fsvol] partition 1 differs on the larger target\n"
                exit 1
            fi

            $SUDO losetup -d "$fs_dev"
            fs_dev=""
        fi
    else
        echo -e "\nlosetup/mkfs.ext4 or privileges unavailable; skipping phase 3\n"
    fi
else
    echo -e "\nsfdisk not found; skipping partition-table tests\n"
fi

echo -e "\ndisk test ok\n"
_ptlbreak
rm -f $img $raw $raw_restore $logfile
