msgstr "完整"

#: src/ptc-gtk4.c:799
msgid ", bootable"
msgstr "，可開機"

#: src/ptc-gtk4.c:806
msgid "File system"
msgstr "檔案系統"

#: src/ptc-gtk4.c:820
msgid "Close"
msgstr "關閉"

#: src/ptc-gtk4.c:859
