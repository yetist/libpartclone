#, c-format
msgid "[!] Unknown backend: %s"
msgstr "[!] 未知後端：%s"

#: src/ptc-gtk4.c:1649
#, c-format
msgid "[!] Unknown mode: %s"
msgstr "[!] 未知模式：%s"

#: src/ptc-gtk4.c:1663
msgid "Clone, check, then do a whole-disk round-trip and quit (headless test)"
msgstr "複製、檢查，然後進行一次整顆磁碟往返測試並結束（無介面測試）"

