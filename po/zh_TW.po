msgstr "=== 映像檔：%s ==="

#: src/ptc-gtk4.c:932
msgid "Select an image to inspect"
msgstr "選擇要檢視的映像檔"

#: src/ptc-gtk4.c:955
msgid "GTK4 front end for the libpartclone partition cloning library."
msgstr "libpartclone 分割區複製函式庫的 GTK4 前端。"

#: src/ptc-gtk4.c:1001
msgid "An operation is still running."
msgstr "仍有操作正在執行。"

#: src/ptc-gtk4.c:1003
msgid "Quitting now will cancel the operation and leave the target incomplete."
msgstr "現在結束將取消操作，並使目標不完整。"

#: src/ptc-gtk4.c:1005 src/ptc-gtk4.c:1553
msgid "Cancel"
msgstr "取消"

#: src/ptc-gtk4.c:1005
msgid "Quit"
msgstr "結束"

#: src/ptc-gtk4.c:1075
msgid "Select source device or image"
msgstr "選擇來源裝置或映像檔"

#: src/ptc-gtk4.c:1110
msgid "Select target device or image"
msgstr "選擇目標裝置或映像檔"

#: src/ptc-gtk4.c:1145
msgid "Select log file"
msgstr "選擇日誌檔"

#: src/ptc-gtk4.c:1224
#, c-format
msgid "self-test: cloning %s"
msgstr "自我測試：正在複製 %s"

#: src/ptc-gtk4.c:1293
msgid "Whole-disk image options (format 0003)"
msgstr "整顆磁碟映像檔選項（格式 0003）"

#: src/ptc-gtk4.c:1309
msgid ""
"How the gaps between partitions (boot loaders, padding, backup GPT) are "
"stored."
msgstr "分割區之間的間隙（開機載入程式、填充、備份 GPT）如何儲存。"

#: src/ptc-gtk4.c:1311
msgid "Gaps"
msgstr "間隙"

#: src/ptc-gtk4.c:1317
msgid ""
"How the partition table is written on restore: verbatim, or rebuilt for a "
"target of a different size."
msgstr "還原時如何寫入分割表：原樣寫入，或為不同大小的目標重建。"

#: src/ptc-gtk4.c:1323
msgid "Store raw volumes sparsely"
msgstr "以稀疏方式儲存原始磁碟區"

#: src/ptc-gtk4.c:1325
msgid ""
"Use a zero-detecting bitmap for raw volumes (gaps and unsupported "
"partitions)."
msgstr "對原始磁碟區（間隙和不支援的分割區）使用零偵測位元圖。"

#: src/ptc-gtk4.c:1328
msgid "Store every partition as raw"
msgstr "將每個分割區儲存為原始磁碟區"

#: src/ptc-gtk4.c:1330
msgid ""
"Do not use the per-filesystem backend, so every partition is a raw volume."
msgstr "不使用依檔案系統的後端，因此每個分割區都是原始磁碟區。"

#: src/ptc-gtk4.c:1333
msgid "Do not zero skipped blocks"
msgstr "不將略過的區塊清零"

#: src/ptc-gtk4.c:1335
msgid ""
"On restore, leave blocks absent from the image untouched instead of writing "
"zeros."
msgstr "還原時，對映像檔中缺少的區塊保持不變，而不是寫入零。"

#: src/ptc-gtk4.c:1338
msgid "Grow the last partition"
msgstr "擴展最後一個分割區"

#: src/ptc-gtk4.c:1340
msgid ""
"On a larger target, extend the last partition entry (the filesystem itself "
"is not resized)."
msgstr "在更大的目標上擴展最後一個分割區項目（檔案系統本身不會調整大小）。"

#: src/ptc-gtk4.c:1363
msgid "_Run"
msgstr "_執行"

#: src/ptc-gtk4.c:1364
msgid "_Inspect image..."
msgstr "檢視映像檔(_I)…"

#: src/ptc-gtk4.c:1365
msgid "_Clear log"
msgstr "_清除日誌"

#: src/ptc-gtk4.c:1366
msgid "_About"
msgstr "_關於"

#: src/ptc-gtk4.c:1367
msgid "_Quit"
msgstr "_結束"

#: src/ptc-gtk4.c:1375
msgid "Main menu"
msgstr "主選單"

#: src/ptc-gtk4.c:1397
msgid "partclone"
msgstr "partclone"

#: src/ptc-gtk4.c:1408
#, c-format
msgid ""
"libpartclone %s\n"
"backends: %s"
msgstr ""
"libpartclone %s\n"
"後端: %s"

#: src/ptc-gtk4.c:1425
msgid "Mode"
msgstr "模式"

#: src/ptc-gtk4.c:1429
msgid ""
"Operation to perform. The available fields change with the selected mode."
msgstr "要執行的操作。可用欄位會隨所選模式而變化。"

#: src/ptc-gtk4.c:1442
msgid "Backend"
msgstr "後端"

#: src/ptc-gtk4.c:1446
msgid ""
"Filesystem backend. Use \"auto (detect)\" to let partclone pick one. Not "
"used for whole-disk images."
msgstr ""
"檔案系統後端。使用\"自動（偵測）\"讓 partclone 自動選擇。整顆磁碟映像檔不使用"
"此項。"

#: src/ptc-gtk4.c:1453
msgid "Source"
msgstr "來源"

#: src/ptc-gtk4.c:1457
msgid "Device or image the data is read from."
msgstr "從中讀取資料的裝置或映像檔。"

#: src/ptc-gtk4.c:1459 src/ptc-gtk4.c:1472 src/ptc-gtk4.c:1486
msgid "Browse..."
msgstr "瀏覽…"

#: src/ptc-gtk4.c:1465
msgid "Target"
msgstr "目標"

#: src/ptc-gtk4.c:1470
msgid "Device or image the data is written to."
msgstr "寫入資料的裝置或映像檔。"

#: src/ptc-gtk4.c:1479
msgid "Log file"
msgstr "日誌檔"

#: src/ptc-gtk4.c:1484
msgid "The engine writes its detailed report to this file."
msgstr "引擎會將詳細報告寫入此檔案。"

#: src/ptc-gtk4.c:1492
msgid "Device size"
msgstr "裝置大小"

#: src/ptc-gtk4.c:1494
msgid "0 = auto (bytes)"
msgstr "0 = 自動（位元組）"

#: src/ptc-gtk4.c:1497
msgid ""
"Override the device size in bytes when it cannot be detected (clone only)."
msgstr "當無法偵測裝置大小時，以位元組為單位覆寫它（僅複製）。"

#: src/ptc-gtk4.c:1504
msgid "Skip target size check (-C)"
msgstr "略過目標大小檢查 (-C)"

#: src/ptc-gtk4.c:1507
msgid "Do not check that the target is large enough before writing."
msgstr "寫入前不檢查目標是否夠大。"

#: src/ptc-gtk4.c:1509
msgid "Force (-F)"
msgstr "強制 (-F)"

#: src/ptc-gtk4.c:1512
msgid ""
"Keep the process alive on recoverable errors and report them in the log "
"instead of aborting."
msgstr "遇到可復原的錯誤時保持行程執行，並記錄到日誌而非中止。"

#: src/ptc-gtk4.c:1515
msgid "Quiet engine output"
msgstr "靜默引擎輸出"

#: src/ptc-gtk4.c:1518
msgid "Suppress the progress messages the engine would print on stdout."
msgstr "抑制引擎原本會列印到標準輸出的進度訊息。"

#: src/ptc-gtk4.c:1520
msgid "Overwrite target (-O)"
msgstr "覆寫目標 (-O)"

#: src/ptc-gtk4.c:1522
msgid ""
"Replace the target if it already exists (required to update an existing "
"image)."
msgstr "若目標已存在則取代（更新既有映像檔時需要）。"

#: src/ptc-gtk4.c:1531
msgid "Debug level"
msgstr "偵錯層級"

#: src/ptc-gtk4.c:1535
msgid "Engine verbosity: 0 quiet, 1 or 2 increasingly detailed."
msgstr "引擎詳細程度：0 安靜，1 或 2 越來越詳細。"

#: src/ptc-gtk4.c:1548
msgid "Run"
msgstr "執行"

#: src/ptc-gtk4.c:1551
msgid "Start the operation (F5)."
msgstr "開始操作 (F5)。"

#: src/ptc-gtk4.c:1555
msgid "Stop the running operation at the next block boundary."
msgstr "在下一個區塊邊界停止正在執行的操作。"

#: src/ptc-gtk4.c:1558
msgid "Clear log"
msgstr "清除日誌"

#: src/ptc-gtk4.c:1559
msgid "Clear the log view (Ctrl+L)."
msgstr "清除日誌檢視 (Ctrl+L)。"

#: src/ptc-gtk4.c:1569
msgid "idle"
msgstr "閒置"

#: src/ptc-gtk4.c:1585
msgid "Ready"
msgstr "就緒"

#: src/ptc-gtk4.c:1625
#, c-format
msgid "libpartclone %s ready."
msgstr "libpartclone %s 就緒。"

