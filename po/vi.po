msgstr "[!] Chế độ không xác định: %s"

#: src/ptc-gtk4.c:1663
msgid "Clone, check, then do a whole-disk round-trip and quit (headless test)"
msgstr ""
"Nhân bản, kiểm tra, sau đó thực hiện một vòng toàn bộ đĩa và thoát (kiểm tra "
"không giao diện)"

#: src/ptc-gtk4.c:1666
msgid "Source device or image"
msgstr "Thiết bị hoặc ảnh nguồn"

#: src/ptc-gtk4.c:1666 src/ptc-gtk4.c:1668
msgid "PATH"
msgstr "ĐƯỜNG_DẪN"

#: src/ptc-gtk4.c:1668
msgid "Target device or image"
msgstr "Thiết bị hoặc ảnh đích"

#: src/ptc-gtk4.c:1670
msgid "Backend name (default: autodetect)"
msgstr "Tên backend (mặc định: tự phát hiện)"

#: src/ptc-gtk4.c:1670
msgid "NAME"
msgstr "TÊN"

#: src/ptc-gtk4.c:1672
msgid ""
"Operation: clone, restore, check, dd, domain, disk-clone, disk-restore or "
"disk-check"
msgstr ""
"Thao tác: clone, restore, check, dd, domain, disk-clone, disk-restore hoặc "
"disk-check"

