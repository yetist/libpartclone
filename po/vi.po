msgid "_Run"
msgstr "_Chạy"

#: src/ptc-gtk4.c:1364
msgid "_Inspect image..."
msgstr "Xem _ảnh..."

#: src/ptc-gtk4.c:1365
msgid "_Clear log"
msgstr "_Xóa nhật ký"

#: src/ptc-gtk4.c:1366
msgid "_About"
msgstr "_Giới thiệu"

#: src/ptc-gtk4.c:1367
msgid "_Quit"
msgstr "_Thoát"

