#, c-format
msgid ""
"libpartclone %s\n"
"backends: %s"
msgstr ""
"libpartclone %s\n"
"các backend: %s"

#: src/ptc-gtk4.c:1425
msgid "Mode"
msgstr "Chế độ"

#: src/ptc-gtk4.c:1429
msgid ""
"Operation to perform. The available fields change with the selected mode."
msgstr ""
"Thao tác cần thực hiện. Các trường khả dụng thay đổi theo chế độ đã chọn."

#: src/ptc-gtk4.c:1442
msgid "Backend"
msgstr "Backend"

#: src/ptc-gtk4.c:1446
msgid ""
"Filesystem backend. Use \"auto (detect)\" to let partclone pick one. Not "
"used for whole-disk images."
msgstr ""
"Backend hệ thống tập tin. Dùng \"tự động (phát hiện)\" để partclone tự chọn. "
"Không dùng cho ảnh toàn bộ đĩa."

#: src/ptc-gtk4.c:1453
msgid "Source"
msgstr "Nguồn"

#: src/ptc-gtk4.c:1457
msgid "Device or image the data is read from."
msgstr "Thiết bị hoặc ảnh mà dữ liệu được đọc từ đó."

#: src/ptc-gtk4.c:1459 src/ptc-gtk4.c:1472 src/ptc-gtk4.c:1486
msgid "Browse..."
msgstr "Duyệt..."

#: src/ptc-gtk4.c:1465
msgid "Target"
msgstr "Đích"

#: src/ptc-gtk4.c:1470
msgid "Device or image the data is written to."
msgstr "Thiết bị hoặc ảnh mà dữ liệu được ghi vào."

#: src/ptc-gtk4.c:1479
msgid "Log file"
msgstr "Tệp nhật ký"

#: src/ptc-gtk4.c:1484
msgid "The engine writes its detailed report to this file."
msgstr "Bộ máy ghi báo cáo chi tiết của nó vào tệp này."

#: src/ptc-gtk4.c:1492
msgid "Device size"
msgstr "Kích thước thiết bị"

#: src/ptc-gtk4.c:1494
msgid "0 = auto (bytes)"
msgstr "0 = tự động (byte)"

#: src/ptc-gtk4.c:1497
msgid ""
"Override the device size in bytes when it cannot be detected (clone only)."
msgstr ""
"Ghi đè kích thước thiết bị theo byte khi không thể phát hiện (chỉ khi nhân "
"bản)."

#: src/ptc-gtk4.c:1504
msgid "Skip target size check (-C)"
msgstr "Bỏ qua kiểm tra kích thước đích (-C)"

#: src/ptc-gtk4.c:1507
msgid "Do not check that the target is large enough before writing."
msgstr "Không kiểm tra xem đích có đủ lớn trước khi ghi."

#: src/ptc-gtk4.c:1509
msgid "Force (-F)"
msgstr "Buộc (-F)"

#: src/ptc-gtk4.c:1512
msgid ""
"Keep the process alive on recoverable errors and report them in the log "
"instead of aborting."
msgstr ""
"Giữ tiến trình tiếp tục khi gặp lỗi có thể phục hồi và báo cáo chúng trong "
"nhật ký thay vì hủy bỏ."

#: src/ptc-gtk4.c:1515
msgid "Quiet engine output"
msgstr "Tắt tiếng xuất của bộ máy"

#: src/ptc-gtk4.c:1518
msgid "Suppress the progress messages the engine would print on stdout."
msgstr "Chặn các thông báo tiến trình mà bộ máy in ra stdout."

#: src/ptc-gtk4.c:1520
msgid "Overwrite target (-O)"
msgstr "Ghi đè đích (-O)"

#: src/ptc-gtk4.c:1522
msgid ""
"Replace the target if it already exists (required to update an existing "
"image)."
msgstr ""
"Thay thế đích nếu nó đã tồn tại (cần thiết để cập nhật một ảnh hiện có)."

#: src/ptc-gtk4.c:1531
msgid "Debug level"
msgstr "Mức gỡ lỗi"

#: src/ptc-gtk4.c:1535
msgid "Engine verbosity: 0 quiet, 1 or 2 increasingly detailed."
msgstr "Độ chi tiết của engine: 0 im lặng, 1 hoặc 2 ngày càng chi tiết."

#: src/ptc-gtk4.c:1548
msgid "Run"
msgstr "Chạy"

#: src/ptc-gtk4.c:1551
msgid "Start the operation (F5)."
msgstr "Bắt đầu thao tác (F5)."

#: src/ptc-gtk4.c:1555
msgid "Stop the running operation at the next block boundary."
msgstr "Dừng thao tác đang chạy tại ranh giới khối tiếp theo."

#: src/ptc-gtk4.c:1558
msgid "Clear log"
msgstr "Xóa nhật ký"

#: src/ptc-gtk4.c:1559
msgid "Clear the log view (Ctrl+L)."
msgstr "Xóa khung xem nhật ký (Ctrl+L)."

#: src/ptc-gtk4.c:1569
msgid "idle"
msgstr "đang chờ"

#: src/ptc-gtk4.c:1585
msgid "Ready"
msgstr "Sẵn sàng"

#: src/ptc-gtk4.c:1625
#, c-format
msgid "libpartclone %s ready."
msgstr "libpartclone %s sẵn sàng."

