#: src/ptc-gtk4.c:828
msgid ""
"Operation to perform. The available target fields change with the selected "
"mode."
msgstr "Thao tác cần thực hiện. Các trường đích khả dụng thay đổi theo chế độ đã chọn."

#: src/ptc-gtk4.c:841
msgid "Backend"
msgstr "Backend"

#: src/ptc-gtk4.c:845
msgid "Filesystem backend. Use \"auto (detect)\" to let partclone pick one."
msgstr "Backend hệ thống tập tin. Dùng \"tự động (phát hiện)\" để partclone tự chọn."

#: src/ptc-gtk4.c:851
msgid "Source"
msgstr "Nguồn"

#: src/ptc-gtk4.c:855
msgid "Device or image the data is read from."
msgstr "Thiết bị hoặc ảnh mà dữ liệu được đọc từ đó."

#: src/ptc-gtk4.c:857 src/ptc-gtk4.c:870 src/ptc-gtk4.c:884
msgid "Browse..."
msgstr "Duyệt..."

#: src/ptc-gtk4.c:863
msgid "Target"
msgstr "Đích"

#: src/ptc-gtk4.c:868
msgid "Device or image the data is written to."
msgstr "Thiết bị hoặc ảnh mà dữ liệu được ghi vào."

#: src/ptc-gtk4.c:877
msgid "Log file"
msgstr "Tệp nhật ký"

#: src/ptc-gtk4.c:882
msgid "The engine writes its detailed report to this file."
msgstr "Bộ máy ghi báo cáo chi tiết của nó vào tệp này."

#: src/ptc-gtk4.c:891
msgid "Skip target size check (-C)"
msgstr "Bỏ qua kiểm tra kích thước đích (-C)"

#: src/ptc-gtk4.c:894
msgid "Do not check that the target is large enough before writing."
msgstr "Không kiểm tra xem đích có đủ lớn trước khi ghi."

#: src/ptc-gtk4.c:896
msgid "Force (-F)"
msgstr "Buộc (-F)"

#: src/ptc-gtk4.c:899
msgid ""
"Keep the process alive on recoverable errors and report them in the log "
"instead of aborting."
msgstr "Giữ tiến trình tiếp tục khi gặp lỗi có thể phục hồi và báo cáo chúng trong nhật ký thay vì hủy bỏ."

#: src/ptc-gtk4.c:902
msgid "Quiet engine output"
msgstr "Tắt tiếng xuất của bộ máy"

#: src/ptc-gtk4.c:905
msgid "Suppress the progress messages the engine would print on stdout."
msgstr "Chặn các thông báo tiến trình mà bộ máy in ra stdout."

#: src/ptc-gtk4.c:907
msgid "Overwrite target (-O)"
msgstr "Ghi đè đích (-O)"

#: src/ptc-gtk4.c:909
msgid ""
"Replace the target if it already exists (required to update an existing "
"image)."
msgstr "Thay thế đích nếu nó đã tồn tại (cần thiết để cập nhật một ảnh hiện có)."

#: src/ptc-gtk4.c:919
msgid "Run"
msgstr "Chạy"

#: src/ptc-gtk4.c:922
msgid "Start the operation (F5)."
msgstr "Bắt đầu thao tác (F5)."

#: src/ptc-gtk4.c:924
msgid "Clear log"
msgstr "Xóa nhật ký"

#: src/ptc-gtk4.c:925
msgid "Clear the log view (Ctrl+L)."
msgstr "Xóa khung xem nhật ký (Ctrl+L)."

