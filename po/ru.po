msgstr "Бэкенд файловой системы. Используйте \"авто (определение)\", чтобы partclone выбрал его сам."

#: src/ptc-gtk4.c:851
msgid "Source"
msgstr "Источник"

#: src/ptc-gtk4.c:855
msgid "Device or image the data is read from."
msgstr "Устройство или образ, из которого читаются данные."

#: src/ptc-gtk4.c:857 src/ptc-gtk4.c:870 src/ptc-gtk4.c:884
msgid "Browse..."
msgstr "Обзор..."

#: src/ptc-gtk4.c:863
msgid "Target"
msgstr "Приёмник"

#: src/ptc-gtk4.c:868
msgid "Device or image the data is written to."
msgstr "Устройство или образ, в который записываются данные."

#: src/ptc-gtk4.c:877
msgid "Log file"
msgstr "Файл журнала"

#: src/ptc-gtk4.c:882
msgid "The engine writes its detailed report to this file."
msgstr "Движок записывает в этот файл свой подробный отчёт."

#: src/ptc-gtk4.c:891
msgid "Skip target size check (-C)"
msgstr "Пропустить проверку размера приёмника (-C)"

#: src/ptc-gtk4.c:894
msgid "Do not check that the target is large enough before writing."
msgstr "Не проверять, достаточно ли велик приёмник, перед записью."

#: src/ptc-gtk4.c:896
msgid "Force (-F)"
msgstr "Принудительно (-F)"

#: src/ptc-gtk4.c:899
msgid ""
"Keep the process alive on recoverable errors and report them in the log "
"instead of aborting."
msgstr "Продолжать работу при устранимых ошибках и сообщать о них в журнале вместо аварийного завершения."

#: src/ptc-gtk4.c:902
msgid "Quiet engine output"
msgstr "Тихий вывод движка"

#: src/ptc-gtk4.c:905
msgid "Suppress the progress messages the engine would print on stdout."
msgstr "Подавлять сообщения о ходе работы, которые движок выводил бы в stdout."

#: src/ptc-gtk4.c:907
msgid "Overwrite target (-O)"
msgstr "Перезаписать приёмник (-O)"

#: src/ptc-gtk4.c:909
msgid ""
"Replace the target if it already exists (required to update an existing "
"image)."
msgstr "Заменить приёмник, если он уже существует (требуется для обновления существующего образа)."

#: src/ptc-gtk4.c:919
msgid "Run"
msgstr "Запустить"

#: src/ptc-gtk4.c:922
msgid "Start the operation (F5)."
msgstr "Начать операцию (F5)."

#: src/ptc-gtk4.c:924
msgid "Clear log"
msgstr "Очистить журнал"

#: src/ptc-gtk4.c:925
msgid "Clear the log view (Ctrl+L)."
msgstr "Очистить окно журнала (Ctrl+L)."

#: src/ptc-gtk4.c:934
msgid "idle"
msgstr "простой"

#: src/ptc-gtk4.c:937
msgid "Ready"
msgstr "Готово"

#: src/ptc-gtk4.c:977
#, c-format
msgid "libpartclone %s ready."
msgstr "libpartclone %s готов."

#: src/ptc-gtk4.c:993
#, c-format
msgid "[!] Unknown backend: %s"
msgstr "[!] Неизвестный бэкенд: %s"

#: src/ptc-gtk4.c:1001
#, c-format
msgid "[!] Unknown mode: %s"
msgstr "[!] Неизвестный режим: %s"

#: src/ptc-gtk4.c:1015
msgid "Clone a temporary file, verify it, then quit (headless test)"
msgstr "Клонировать временный файл, проверить его и выйти (тест без интерфейса)"

#: src/ptc-gtk4.c:1018
msgid "Source device or image"
msgstr "Исходное устройство или образ"

#: src/ptc-gtk4.c:1018 src/ptc-gtk4.c:1020
msgid "PATH"
msgstr "ПУТЬ"

#: src/ptc-gtk4.c:1020
msgid "Target device or image"
msgstr "Приёмник или образ"

#: src/ptc-gtk4.c:1022
msgid "Backend name (default: autodetect)"
msgstr "Имя бэкенда (по умолчанию: автоопределение)"

#: src/ptc-gtk4.c:1022
msgid "NAME"
msgstr "ИМЯ"

#: src/ptc-gtk4.c:1024
msgid "Operation: clone, restore, check, dd or domain"
msgstr "Операция: clone, restore, check, dd или domain"

#: src/ptc-gtk4.c:1024
msgid "MODE"
msgstr "РЕЖИМ"

#: src/ptc-gtk4.c:1026
msgid "SOURCE"
msgstr "ИСТОЧНИК"
