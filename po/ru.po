msgid "Volumes"
msgstr "Тома"

#: src/ptc-gtk4.c:793
#, c-format
msgid "Volume %u: %s (%s) at %s, length %s, %s%s\n"
msgstr "Том %u: %s (%s) со смещения %s, длина %s, %s%s\n"

#: src/ptc-gtk4.c:796
