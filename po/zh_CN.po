msgid "Main menu"
msgstr "主菜单"

#: src/ptc-gtk4.c:1397
msgid "partclone"
msgstr "partclone"

#: src/ptc-gtk4.c:1408
#, c-format
msgid ""
"libpartclone %s\n"
"backends: %s"
msgstr ""
"libpartclone %s\n"
"后端: %s"

#: src/ptc-gtk4.c:1425
msgid "Mode"
msgstr "模式"

#: src/ptc-gtk4.c:1429
msgid ""
"Operation to perform. The available fields change with the selected mode."
msgstr "要执行的操作。可用字段会随所选模式而变化。"

#: src/ptc-gtk4.c:1442
msgid "Backend"
msgstr "后端"

#: src/ptc-gtk4.c:1446
msgid ""
"Filesystem backend. Use \"auto (detect)\" to let partclone pick one. Not "
"used for whole-disk images."
msgstr ""
"文件系统后端。使用\"自动（检测）\"让 partclone 自动选择。整盘镜像不使用此项。"

#: src/ptc-gtk4.c:1453
msgid "Source"
msgstr "源"

#: src/ptc-gtk4.c:1457
msgid "Device or image the data is read from."
msgstr "从中读取数据的设备或镜像。"

#: src/ptc-gtk4.c:1459 src/ptc-gtk4.c:1472 src/ptc-gtk4.c:1486
msgid "Browse..."
msgstr "浏览…"

#: src/ptc-gtk4.c:1465
msgid "Target"
msgstr "目标"

#: src/ptc-gtk4.c:1470
msgid "Device or image the data is written to."
msgstr "写入数据的设备或镜像。"

#: src/ptc-gtk4.c:1479
msgid "Log file"
msgstr "日志文件"

#: src/ptc-gtk4.c:1484
msgid "The engine writes its detailed report to this file."
msgstr "引擎会将详细报告写入此文件。"

#: src/ptc-gtk4.c:1492
msgid "Device size"
msgstr "设备大小"

#: src/ptc-gtk4.c:1494
msgid "0 = auto (bytes)"
msgstr "0 = 自动（字节）"

#: src/ptc-gtk4.c:1497
msgid ""
"Override the device size in bytes when it cannot be detected (clone only)."
msgstr "当无法检测设备大小时，以字节为单位覆盖它（仅克隆）。"

#: src/ptc-gtk4.c:1504
msgid "Skip target size check (-C)"
msgstr "跳过目标大小检查 (-C)"

#: src/ptc-gtk4.c:1507
msgid "Do not check that the target is large enough before writing."
msgstr "写入前不检查目标是否足够大。"

#: src/ptc-gtk4.c:1509
msgid "Force (-F)"
msgstr "强制 (-F)"

#: src/ptc-gtk4.c:1512
msgid ""
"Keep the process alive on recoverable errors and report them in the log "
"instead of aborting."
msgstr "遇到可恢复的错误时保持进程运行，并记录到日志而不是中止。"

#: src/ptc-gtk4.c:1515
msgid "Quiet engine output"
msgstr "静默引擎输出"

#: src/ptc-gtk4.c:1518
msgid "Suppress the progress messages the engine would print on stdout."
msgstr "抑制引擎本应打印到标准输出的进度消息。"

#: src/ptc-gtk4.c:1520
msgid "Overwrite target (-O)"
msgstr "覆盖目标 (-O)"

#: src/ptc-gtk4.c:1522
msgid ""
"Replace the target if it already exists (required to update an existing "
"image)."
msgstr "如果目标已存在则替换（更新已有镜像时需要）。"

#: src/ptc-gtk4.c:1531
msgid "Debug level"
msgstr "调试级别"

#: src/ptc-gtk4.c:1535
msgid "Engine verbosity: 0 quiet, 1 or 2 increasingly detailed."
msgstr "引擎详细程度：0 安静，1 或 2 越来越详细。"

#: src/ptc-gtk4.c:1548
msgid "Run"
msgstr "运行"

#: src/ptc-gtk4.c:1551
msgid "Start the operation (F5)."
msgstr "开始操作 (F5)。"

#: src/ptc-gtk4.c:1555
msgid "Stop the running operation at the next block boundary."
msgstr "在下一个块边界停止正在运行的操作。"

#: src/ptc-gtk4.c:1558
msgid "Clear log"
msgstr "清除日志"

#: src/ptc-gtk4.c:1559
msgid "Clear the log view (Ctrl+L)."
msgstr "清除日志视图 (Ctrl+L)。"

#: src/ptc-gtk4.c:1569
msgid "idle"
msgstr "空闲"

#: src/ptc-gtk4.c:1585
msgid "Ready"
msgstr "就绪"

#: src/ptc-gtk4.c:1625
#, c-format
msgid "libpartclone %s ready."
msgstr "libpartclone %s 就绪。"

